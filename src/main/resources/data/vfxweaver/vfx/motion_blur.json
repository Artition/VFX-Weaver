{
  "type": "motion_blur",
  "duration": 40,
  "easing": "ease_in_out_cubic",
  "persistent": false,
  "loop": false,
  "fade_ticks": 0,
  "params": {
    "intensity": { "start": 0.35, "end": 0.0 },
    "yaw_delta": { "bind": "camera_yaw_delta", "range": 1.0 },
    "pitch_delta": { "bind": "camera_pitch_delta", "range": 1.0 }
  }
}
